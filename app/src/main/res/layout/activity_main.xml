<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name">

        <TextView
            android:id="@+id/server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:text="@string/server_status_stopped"
            android:textColor="@color/status_off"
            android:textSize="12sp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/storage_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_change_storage_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/change_storage_short"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/filter_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:focusable="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/filter_all"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/filter_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:focusable="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/filter_active"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/filter_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:focusable="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/filter_completed"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/filter_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:focusable="true"
            android:gravity="center"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/filter_failed"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sort_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:gravity="end"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/sort_by"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/input_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:hint="@string/search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/btn_pause_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:paddingVertical="6dp"
            android:text="@string/pause_all"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_resume_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:paddingVertical="6dp"
            android:text="@string/resume_all"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_retry_failed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:paddingVertical="6dp"
            android:text="@string/retry_failed"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingBottom="88dp" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_hint"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/add_download"
            android:src="@drawable/ic_add" />
    </FrameLayout>
</LinearLayout>
