<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

    <CheckBox
        android:id="@+id/check_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_background" />

    <CheckBox
        android:id="@+id/check_autostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_autostart" />

    <CheckBox
        android:id="@+id/check_server_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_server_background" />

    <CheckBox
        android:id="@+id/check_server_autostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_server_autostart" />

    <CheckBox
        android:id="@+id/check_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_battery" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_pin_label"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <EditText
        android:id="@+id/input_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_pin_hint"
        android:inputType="numberPassword"
        android:maxLength="10" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_port_label"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <EditText
        android:id="@+id/input_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_port_hint"
        android:importantForAutofill="no"
        android:inputType="number" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_concurrent"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <Spinner
        android:id="@+id/spinner_concurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_speed_limit"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <Spinner
        android:id="@+id/spinner_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_retry"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <Spinner
        android:id="@+id/spinner_retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_segments"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <Spinner
        android:id="@+id/spinner_segments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/storage_section"
        layout="@layout/view_storage_section" />
    </LinearLayout>
</ScrollView>
